---
interface QA {
  q: string;
  a: string; // may contain simple HTML links
}

interface Props {
  items: QA[];
  title?: string;
  id?: string;
}

const { items, title = 'Frequently asked questions', id = 'faq' } = Astro.props;

const faqSchema = items && items.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a.replace(/<[^>]*>?/gm, '').trim(),
    },
  })),
} : null;
---

<section class="section" aria-labelledby={id}>
  <h2 id={id}>{title}</h2>
  <div class="faq">
    {items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <div class="faq-body"><p set:html={item.a} /></div>
      </details>
    ))}
  </div>
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
</section>
