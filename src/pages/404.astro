---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const title = 'Page Not Found (404) | SensForge';
const description = 'This page does not exist. Jump back to the tools or search for what you need.';
---

<Base title={title} description={description} canonical="/404" noindex>
  <div class="wrap-narrow" style="padding:60px 0">
    <h1>404 — page not found</h1>
    <p class="lead">
      The page you requested does not exist (or has moved). The tools are all still here:
    </p>
    <ul>
      <li><a href="/sensitivity-converter/">Mouse sensitivity converter</a></li>
      <li><a href="/edpi-calculator/">eDPI calculator</a></li>
      <li><a href="/cm-360-calculator/">cm/360 calculator</a></li>
      <li><a href="/fov-calculator/">FOV calculator</a></li>
      <li><a href="/tools/">All tools</a></li>
    </ul>
    <p><a class="btn btn-primary" href="/">← Back to home</a></p>
  </div>
</Base>
