---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';

const title = 'Terms of Use | SensForge';
const description = 'SensForge terms of use: free browser tools provided as-is, acceptable use, and limitations of liability.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Terms' },
];
---

<Base title={title} description={description} breadcrumbs={breadcrumbs} canonical="/terms/">
  <div class="wrap-narrow">
    <Breadcrumbs items={breadcrumbs} />

    <h1>Terms of use</h1>
    <p class="small muted">Effective date: 07 Oct 2026</p>

    <section class="section">
      <h2 id="service">1. The service</h2>
      <p>
        SensForge provides free, browser-based calculators and utilities ("the Tools"). By using the site
        you agree to these terms. If you do not agree, do not use the site.
      </p>
    </section>

    <section class="section">
      <h2 id="use">2. Acceptable use</h2>
      <ul>
        <li>Do not attempt to disrupt, scrape at abusive volume, or reverse-engineer non-public parts of the site.</li>
        <li>Do not resell the Tools as your own or misrepresent results as affiliated with any game publisher.</li>
        <li>Personal and commercial use of the numbers the Tools produce is fine.</li>
      </ul>
    </section>

    <section class="section">
      <h2 id="accuracy">3. Accuracy &amp; warranties</h2>
      <p>
        The Tools are provided <strong>"as is"</strong>. We work to keep constants accurate and labeled
        (see the <a href="/methodology/">methodology page</a>), but sensitivity "feel" is personal and some
        values are approximations. We make no warranty of fitness for a particular purpose, including
        tournament compliance, which you must check against your league's rules.
      </p>
    </section>

    <section class="section">
      <h2 id="ip">4. Trademarks</h2>
      <p>
        Game titles (Valorant, Counter-Strike 2, Apex Legends, Overwatch 2, Fortnite, Rainbow Six Siege,
        Call of Duty, Marvel Rivals, The Finals, Destiny 2, Halo Infinite, Deadlock) are trademarks of
        their respective owners. SensForge is not affiliated with, endorsed by, or sponsored by any game
        publisher. Constants are used as facts for interoperability of player settings.
      </p>
    </section>

    <section class="section">
      <h2 id="liability">5. Limitation of liability</h2>
      <p>
        To the maximum extent permitted by law, SensForge and its operators are not liable for indirect
        or consequential damages arising from your use of the Tools. Because the Tools are free, aggregate
        liability is limited to €0.
      </p>
    </section>

    <section class="section">
      <h2 id="changes">6. Changes</h2>
      <p>
        We may update these terms; the effective date above always reflects the current version. Continued
        use after changes constitutes acceptance.
      </p>
    </section>

    <section class="section">
      <h2 id="contact-terms">7. Contact</h2>
      <p>{site.email}</p>
    </section>
  </div>
</Base>
