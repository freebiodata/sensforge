---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import TrustBlock from '../../components/TrustBlock.astro';
import { games } from '../../data/games';
import { site } from '../../data/site';

const title = 'Mouse Sensitivity Converter (Valorant, CS2, Apex, Fortnite) | SensForge';
const description =
  'Convert mouse sensitivity between Valorant, CS2, Apex Legends, Overwatch 2, Fortnite, and CoD. 1:1 cm/360 and eDPI matching, 100% free with yaw-exact maths.';

const jsonLd = [
  {
    '@type': 'WebApplication',
    '@id': `${site.url}/sensitivity-converter/#app`,
    name: 'Mouse Sensitivity Converter',
    url: `${site.url}/sensitivity-converter/`,
    description:
      'Convert mouse sensitivity between 13 FPS games by matching cm/360 (physical mouse distance per 360° turn).',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Converters', href: '/tools/' },
  { name: 'Sensitivity converter' },
];

const faq = [
  {
    q: 'How does the sensitivity converter work?',
    a: 'It uses each game\'s internal yaw value (the degrees of horizontal camera rotation executed per raw mouse count) to maintain your exact physical <strong>cm/360</strong>. If you move your mouse 38 cm for a full 360° turn in CS2, you will move it exactly 38 cm in Valorant as well.',
  },
  {
    q: 'Why can\'t I just copy the same slider number between games?',
    a: 'Because game engines use completely different sensitivity multipliers. For instance, CS2 rotates 0.022° per count, whereas Valorant rotates 0.07° per count. Entering 1.5 in Valorant would be over three times faster than 1.5 in CS2. Converting via cm/360 eliminates this discrepancy.',
  },
  {
    q: 'Should I convert with the same DPI or can I change my mouse DPI?',
    a: 'You can convert using the same DPI or switch to a new DPI. The calculator factors both source and target DPI into the equation, allowing you to seamlessly transition from 400 DPI to 800 or 1600 DPI while maintaining the exact same physical in-game turn feel.',
  },
  {
    q: 'What is cm/360 and why is it superior to eDPI?',
    a: 'cm/360 is the physical distance (in centimeters) your mouse travels across your mousepad to turn a full 360 degrees in game. Unlike eDPI, which is only valid within a single game engine, cm/360 is universal across all FPS games and hardware configurations.',
  },
  {
    q: 'Why does my aim feel faster in games with a wider FOV?',
    a: 'When Field of View (FOV) increases, more visual environment is compressed onto your monitor screen. Even though your physical 360° turn distance remains identical, targets on screen appear smaller and traverse screen pixels faster, creating the subjective feeling of higher sensitivity. Use our <a href="/fov-calculator/">FOV Calculator</a> to explore visual focal length matching.',
  },
  {
    q: 'What is Scoped / ADS Sensitivity and does this tool convert it?',
    a: 'This calculator converts hipfire (1x magnification) sensitivity. When Aiming Down Sights (ADS) or using sniper scopes, games reduce your FOV and apply zoom multipliers. Most competitive players use Monitor Distance Matching (0% or 133% coefficient) to maintain crosshair flick consistency while scoped.',
  },
  {
    q: 'Is 800 DPI or 1600 DPI better for competitive gaming?',
    a: 'Modern optical sensors (such as the PixArt 3395 and 3950) exhibit lower input latency and smoother micro-stepping at 1600 DPI compared to 400 DPI. Running 1600 DPI with a halved in-game sensitivity offers lower click-to-motion latency without introducing sensor jitter.',
  },
  {
    q: 'Is my input data stored or tracked anywhere?',
    a: 'No. Every calculation executes 100% client-side inside your browser using vanilla JavaScript. Nothing is sent to our servers, no accounts are required, and your settings remain entirely private.',
  },
];

const gameOptions = games.map((g) => ({ id: g.id, name: g.name, yaw: g.yaw, note: g.yawNote, typical: g.typicalSens, decimals: g.sensDecimals, defaultSens: g.defaultSens }));
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  canonical="/sensitivity-converter/"
>
  <div class="wrap">
    <Breadcrumbs items={breadcrumbs} />

    <div class="hero">
      <h1>Mouse Sensitivity Converter</h1>
      <p class="value-line">
        Convert your sensitivity between Valorant, CS2, Apex Legends, Overwatch 2, Fortnite and 7 more
        games, matching <strong>cm/360</strong> so your aim feels identical. Free, no sign-up.
      </p>
      <ul class="trust-microline">
        <li class="badge badge-green">Runs in your browser</li>
        <li class="badge">Free · No sign-up</li>
        <li class="badge">13 games · yaw-based math</li>
      </ul>
    </div>

    <!-- Quick Conversion Formula Callout (Featured Snippet target) -->
    <div class="card" style="background:var(--bg-inset);border-left:4px solid var(--accent);margin:18px 0 24px;padding:16px 20px;">
      <strong style="color:var(--text);font-size:1.05rem;display:block;margin-bottom:6px">Quick Conversion Formula:</strong>
      <p style="margin:0 0 8px;font-family:var(--font-mono);font-size:0.95rem;color:var(--green)">
        Target Sensitivity = (Source Sens × Source DPI × Source Yaw) ÷ (Target DPI × Target Yaw)
      </p>
      <span class="small muted">
        Matches physical <strong>cm/360</strong> turn distance so flick distances and muscle memory carry over 1:1 between games.
      </span>
    </div>

    <!-- ============ THE TOOL ============ -->
    <section class="tool" aria-labelledby="tool-heading" id="converter">
      <h2 id="tool-heading" class="visually-hidden">Sensitivity converter tool</h2>

      <div class="tool-grid cols-2">
        <div>
          <div class="field">
            <label for="src-game">From game</label>
            <select id="src-game" name="src-game">
              {gameOptions.map((g) => (
                <option value={g.id} selected={g.id === 'cs2'}>{g.name}</option>
              ))}
            </select>
            <span class="helper" id="src-yaw-note">CS2 sensitivity (e.g. 2.0)</span>
          </div>

          <div class="field">
            <label for="src-sens">Your sensitivity</label>
            <input
              type="number"
              id="src-sens"
              name="src-sens"
              inputmode="decimal"
              min="0.001"
              step="0.001"
              value="2"
              autocomplete="off"
            />
            <span class="helper" id="src-sens-helper">Typical range: 0.4 – 3.5</span>
            <span class="error" id="src-sens-error" role="alert">Enter a sensitivity greater than 0.</span>
          </div>

          <div class="field">
            <label for="src-dpi">Mouse DPI</label>
            <input
              type="number"
              id="src-dpi"
              name="src-dpi"
              inputmode="numeric"
              min="50"
              max="12000"
              step="50"
              value="800"
              autocomplete="off"
            />
            <span class="helper">Drivers → DPI, or use the <a href="/dpi-analyzer/">DPI analyzer</a> if unsure.</span>
            <span class="error" id="src-dpi-error" role="alert">Enter a DPI between 50 and 12,000.</span>
          </div>

          <div class="chips" aria-label="Common DPI presets">
            <button class="chip" type="button" data-dpi="400">400 DPI</button>
            <button class="chip" type="button" data-dpi="800">800 DPI</button>
            <button class="chip" type="button" data-dpi="1600">1600 DPI</button>
          </div>
        </div>

        <div>
          <div class="field">
            <label for="dst-game">To game</label>
            <select id="dst-game" name="dst-game">
              {gameOptions.map((g) => (
                <option value={g.id} selected={g.id === 'valorant'}>{g.name}</option>
              ))}
            </select>
            <span class="helper" id="dst-yaw-note">Valorant sensitivity</span>
          </div>

          <div class="field">
            <label for="dst-dpi">Target mouse DPI</label>
            <input
              type="number"
              id="dst-dpi"
              name="dst-dpi"
              inputmode="numeric"
              min="50"
              max="12000"
              step="50"
              value="800"
              autocomplete="off"
            />
            <span class="helper">Leave equal to source DPI for a straight conversion.</span>
            <span class="error" id="dst-dpi-error" role="alert">Enter a DPI between 50 and 12,000.</span>
          </div>

          <div class="field">
            <label>Swap direction</label>
            <button class="btn btn-secondary" type="button" id="swap-btn">
              ⇆ Swap from / to
            </button>
          </div>
        </div>
      </div>

      <!-- Result panel (space reserved to avoid CLS) -->
      <div class="result-panel" id="result" aria-live="polite">
        <div class="result-empty" id="result-empty">
          Enter your sensitivity on the left, the converted value appears here instantly.
        </div>

        <div id="result-body" hidden>
          <div class="small muted" id="result-caption">Your Valorant sensitivity</div>
          <div class="result-value" id="result-value">-</div>
          <div class="result-meta">
            <div class="kv"><div class="k">cm/360 (both games)</div><div class="v" id="out-cm360">-</div></div>
            <div class="kv"><div class="k">eDPI (from)</div><div class="v" id="out-edpi-src">-</div></div>
            <div class="kv"><div class="k">eDPI (to)</div><div class="v" id="out-edpi-dst">-</div></div>
            <div class="kv"><div class="k">360° distance</div><div class="v" id="out-inches">-</div></div>
          </div>
          <div class="result-actions">
            <button class="btn btn-primary" type="button" id="copy-btn">
              <span class="normal-label">Copy converted sensitivity</span>
              <span class="copied-label">✓ Copied</span>
            </button>
            <button class="btn btn-secondary" type="button" id="share-btn">
              <span class="normal-label">Copy share link</span>
              <span class="copied-label">✓ Link copied</span>
            </button>
            <a class="btn btn-secondary" href="/edpi-calculator/">Check your eDPI →</a>
          </div>
          <p class="small muted" style="margin:10px 0 0" id="history-line" hidden></p>
        </div>
      </div>

      <p class="small muted" style="margin-top:12px">
        All math runs locally in your browser. Nothing you type is uploaded, logged or stored.
      </p>
    </section>

    <!-- In-Depth Step-by-Step Conversion Guide -->
    <section class="section" aria-labelledby="how-to">
      <h2 id="how-to">Step-by-Step Sensitivity Conversion Guide</h2>
      <ol class="steps">
        <li>
          <strong>Check your current in-game sensitivity:</strong> Boot up your primary game, navigate to Settings → Mouse / Controls, and note your exact sensitivity value (e.g. <code>2.0</code> in CS2 or <code>0.45</code> in Valorant).
        </li>
        <li>
          <strong>Verify your mouse hardware DPI:</strong> Open your mouse manufacturer software (e.g. Razer Synapse, Logitech G HUB, Wooting, or Endgame Gear) to confirm your active DPI profile. Common competitive baselines are 400, 800, or 1600 DPI.
        </li>
        <li>
          <strong>Select your source and target games:</strong> Choose your current title in "From game" and the new game you are playing in "To game". If keeping the same mouse, leave the Target DPI equal to your source DPI.
        </li>
        <li>
          <strong>Apply the converted value:</strong> Copy the converted sensitivity and paste or slide it into your target game's settings. Because your <strong>cm/360</strong> is matched, your physical hand movements for 90° checks and 180° turns remain identical.
        </li>
        <li>
          <strong>Test in practice range before ranked:</strong> Run a 10-minute deathmatch session. If the game uses a different FOV or camera height, give your visual cortex a brief period to adapt before tweaking settings.
        </li>
      </ol>
    </section>

    <!-- Deep Technical Breakdown: The Mathematics of Game Engine Yaw -->
    <section class="section" aria-labelledby="how-works">
      <h2 id="how-works">The Mathematics of FPS Mouse Input &amp; Game Engine Yaw</h2>
      <div class="card">
        <p>
          Every 3D first-person shooter translates mouse movement into view angle rotation using an internal multiplier known as <strong>yaw</strong> (degrees of camera rotation per raw sensor count).
        </p>
        <p>
          When you move your mouse horizontally, your mouse reports raw displacement counts to Windows. The game engine multiplies these counts by both your in-game sensitivity slider and its hard-coded yaw factor:
        </p>
        <div style="background:var(--bg-inset);border-left:4px solid var(--accent);padding:14px 18px;border-radius:4px;margin:16px 0">
          <strong style="color:var(--text);display:block;margin-bottom:6px">Rotation Formula:</strong>
          <code>Degrees Rotated = Mouse Counts × Sensitivity × Yaw</code>
        </div>
        <p>
          To maintain identical muscle memory across titles, the physical distance required to execute a full 360° turn (<strong>cm/360</strong>) must remain constant:
        </p>
        <div style="background:var(--bg-inset);border-left:4px solid var(--green);padding:14px 18px;border-radius:4px;margin:16px 0">
          <strong style="color:var(--text);display:block;margin-bottom:6px">Universal cm/360 Formula:</strong>
          <code>cm/360 = (360 ÷ (Sensitivity × DPI × Yaw)) × 2.54</code>
        </div>

        <h3 style="margin-top:24px">Worked Example: CS2 to Valorant Conversion</h3>
        <p class="small muted">
          Suppose you play Counter-Strike 2 at <strong>2.0 sensitivity</strong> on <strong>800 DPI</strong> and want your exact equivalent in Valorant:
        </p>
        <ul class="small muted">
          <li><strong>CS2 Engine Yaw:</strong> <code>0.022°</code></li>
          <li><strong>Valorant Engine Yaw:</strong> <code>0.070°</code></li>
          <li><strong>Calculation:</strong> <code>(2.0 × 800 × 0.022) ÷ (800 × 0.070) = 35.2 ÷ 56.0 = 0.629</code></li>
          <li><strong>Physical Result:</strong> Both settings produce exactly <strong>25.98 cm/360</strong> on your mousepad.</li>
        </ul>
      </div>
    </section>

    <!-- Game Engine Yaw Reference Table -->
    <section class="section" aria-labelledby="yaw-table-heading">
      <h2 id="yaw-table-heading">FPS Game Engine Yaw Constants Reference</h2>
      <p class="lead">
        Below are the documented horizontal camera rotation constants across major competitive titles.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Game Title</th>
              <th>Engine Heritage</th>
              <th class="num">Yaw Constant (°/count)</th>
              <th>Confidence Level</th>
              <th>Typical Pro Range</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Counter-Strike 2</strong></td>
              <td>Source 2 (Valve)</td>
              <td class="num">0.022000</td>
              <td><span class="badge badge-green">Confirmed (m_yaw cvar)</span></td>
              <td>0.7 – 2.5 @ 800 DPI</td>
            </tr>
            <tr>
              <td><strong>Valorant</strong></td>
              <td>Unreal Engine 4 (Riot)</td>
              <td class="num">0.070000</td>
              <td><span class="badge badge-green">Confirmed</span></td>
              <td>0.2 – 0.55 @ 800 DPI</td>
            </tr>
            <tr>
              <td><strong>Apex Legends</strong></td>
              <td>Source Engine (Respawn)</td>
              <td class="num">0.022000</td>
              <td><span class="badge badge-green">Confirmed</span></td>
              <td>1.1 – 2.2 @ 800 DPI</td>
            </tr>
            <tr>
              <td><strong>Overwatch 2</strong></td>
              <td>Proprietary (Blizzard)</td>
              <td class="num">0.006600</td>
              <td><span class="badge badge-green">Confirmed</span></td>
              <td>3.5 – 8.0 @ 800 DPI</td>
            </tr>
            <tr>
              <td><strong>Fortnite</strong></td>
              <td>Unreal Engine 5 (Epic)</td>
              <td class="num">0.005555</td>
              <td><span class="badge">Corroborated</span></td>
              <td>5.5% – 10.0% @ 800 DPI</td>
            </tr>
            <tr>
              <td><strong>Call of Duty (Warzone/MW)</strong></td>
              <td>IW Engine (Activision)</td>
              <td class="num">0.006600</td>
              <td><span class="badge badge-green">Confirmed</span></td>
              <td>3.5 – 7.5 @ 800 DPI</td>
            </tr>
            <tr>
              <td><strong>Rainbow Six Siege</strong></td>
              <td>AnvilNext 2.0 (Ubisoft)</td>
              <td class="num">0.005720</td>
              <td><span class="badge">Corroborated</span></td>
              <td>30 – 70 @ 800 DPI</td>
            </tr>
            <tr>
              <td><strong>Marvel Rivals</strong></td>
              <td>Unreal Engine 5 (NetEase)</td>
              <td class="num">0.006600</td>
              <td><span class="badge">Corroborated</span></td>
              <td>4.0 – 8.0 @ 800 DPI</td>
            </tr>
            <tr>
              <td><strong>The Finals</strong></td>
              <td>Unreal Engine 5 (Embark)</td>
              <td class="num">0.006600</td>
              <td><span class="badge">Corroborated</span></td>
              <td>20 – 45 @ 800 DPI</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:10px">
        Full source audit and community measurement records are documented on the <a href="/methodology/">methodology page</a>.
      </p>
    </section>

    <!-- Sensitivity Brackets Guide -->
    <section class="section" aria-labelledby="brackets-heading">
      <h2 id="brackets-heading">Sensitivity Brackets: Low vs Medium vs High Sensitivity</h2>
      <p class="lead">
        Choosing the right sensitivity category depends heavily on your mousepad dimensions, aiming style, and target game genre:
      </p>
      <div class="tool-grid cols-3">
        <div class="card">
          <h3 style="margin-top:0">Low Sens (&gt;45 cm/360)</h3>
          <p class="small muted">
            <strong>Ideal For:</strong> Tactical shooters (Valorant, CS2, Rainbow Six Siege).
          </p>
          <p class="small muted">
            <strong>Strengths:</strong> Supreme micro-adjustment accuracy, consistent crosshair placement, zero nervous jitter.
          </p>
          <p class="small muted" style="margin-bottom:0">
            <strong>Requirements:</strong> Large desk mat (450×400mm+), lightweight mouse, and disciplined whole-arm aiming from the elbow.
          </p>
        </div>
        <div class="card">
          <h3 style="margin-top:0">Medium Sens (28–45 cm/360)</h3>
          <p class="small muted">
            <strong>Ideal For:</strong> Battle Royales &amp; Track-heavy shooters (Apex Legends, Warzone, Overwatch Hitscan).
          </p>
          <p class="small muted">
            <strong>Strengths:</strong> Harmonious balance between 180° emergency resets and smooth mid-range tracking.
          </p>
          <p class="small muted" style="margin-bottom:0">
            <strong>Requirements:</strong> Standard mousepad (350×300mm), hybrid arm/wrist movement technique.
          </p>
        </div>
        <div class="card">
          <h3 style="margin-top:0">High Sens (&lt;28 cm/360)</h3>
          <p class="small muted">
            <strong>Ideal For:</strong> Fast Arena &amp; Vertical shooters (Fortnite building, Overwatch Projectile/Tracer, The Finals).
          </p>
          <p class="small muted">
            <strong>Strengths:</strong> Lightning-fast 180°/360° turns, effortless vertical tracking, minimal arm fatigue.
          </p>
          <p class="small muted" style="margin-bottom:0">
            <strong>Requirements:</strong> High-friction control mousepad and fine finger/wrist dexterity to prevent overshooting.
          </p>
        </div>
      </div>
    </section>

    <!-- Scoped & ADS Sensitivity Guide -->
    <section class="section" aria-labelledby="scoped-heading">
      <h2 id="scoped-heading">Scoped &amp; ADS Sensitivity: Understanding Monitor Distance Matching</h2>
      <div class="card">
        <p>
          When you aim down sights (ADS) or look through a sniper scope, the game narrows your camera Field of View to magnify targets. Because your FOV changes, matching 360° turn distance while zoomed in would make crosshair movement feel impossibly fast and uncontrollable.
        </p>
        <p>
          To maintain consistent aiming mechanics while scoped, competitive shooters utilize <strong>Monitor Distance Matching (MDM)</strong>:
        </p>
        <ul class="small muted">
          <li>
            <strong>0% Monitor Distance Matching:</strong> Matches your angular velocity at the exact center of the screen (your crosshair). Recommended for tracking targets, micro-adjustments, and high-zoom sniper rifles (e.g. Valorant Operator or CS2 AWP zoom sensitivity ratio <code>1.0</code>).
          </li>
          <li>
            <strong>133% Monitor Distance Matching:</strong> Matches target motion at the 4:3 boundary of a 16:9 display. Provides a natural visual transition for medium-range scopes (2x – 4x optics in Apex Legends and Call of Duty).
          </li>
          <li>
            <strong>178% Monitor Distance Matching:</strong> Matches target movement at the outer edges of a 16:9 monitor. Best suited for ultra-wide flicks.
          </li>
        </ul>
      </div>
    </section>

    <!-- Example conversions table -->
    <section class="section" aria-labelledby="examples">
      <h2 id="examples">Common Cross-Game Conversions (800 DPI)</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>From</th>
              <th class="num">Sens</th>
              <th>To</th>
              <th class="num">Converted sens</th>
              <th class="num">cm/360</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>CS2</td><td class="num">2.000</td><td>Valorant</td><td class="num">0.629</td><td class="num">26.0 cm</td></tr>
            <tr><td>Valorant</td><td class="num">0.400</td><td>CS2</td><td class="num">1.273</td><td class="num">40.8 cm</td></tr>
            <tr><td>CS2</td><td class="num">1.500</td><td>Apex Legends</td><td class="num">1.500</td><td class="num">34.6 cm</td></tr>
            <tr><td>Overwatch 2</td><td class="num">5.000</td><td>Valorant</td><td class="num">0.471</td><td class="num">34.6 cm</td></tr>
            <tr><td>Fortnite</td><td class="num">8.0%</td><td>CS2</td><td class="num">2.020</td><td class="num">25.7 cm</td></tr>
            <tr><td>Apex Legends</td><td class="num">1.400</td><td>Overwatch 2</td><td class="num">4.667</td><td class="num">37.1 cm</td></tr>
            <tr><td>Call of Duty</td><td class="num">6.000</td><td>Valorant</td><td class="num">0.566</td><td class="num">28.9 cm</td></tr>
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:10px">
        Calculated using verified engine yaw constants at 800 native mouse DPI.
      </p>
    </section>

    <!-- FAQ -->
    <Faq items={faq} />

    <TrustBlock>
      <p class="mb-0">
        <strong>Built how?</strong> The converter runs entirely client-side, no uploads, no accounts.
        The yaw constants and formulas used here are documented on the <a href="/methodology/">methodology page</a>,
        with confidence labels for every game value. Found a wrong value? <a href="/contact/">Tell us</a>, corrections ship with credit.
      </p>
    </TrustBlock>

    <!-- Related tools -->
    <section class="section" aria-labelledby="related">
      <h2 id="related">Related Aiming Calculators &amp; Guides</h2>
      <ul class="related-grid" style="list-style:none;padding:0">
        <li><a class="tool-card" href="/edpi-calculator/"><span class="tc-title">eDPI Calculator</span><p class="tc-desc">Calculate effective DPI and compare against competitive rank benchmarks.</p></a></li>
        <li><a class="tool-card" href="/cm-360-calculator/"><span class="tc-title">cm/360 Calculator</span><p class="tc-desc">Measure physical mousepad travel distance per 360° turn across all games.</p></a></li>
        <li><a class="tool-card" href="/fov-calculator/"><span class="tc-title">FOV Calculator</span><p class="tc-desc">Convert field of view across aspect ratios with monitor-distance matching.</p></a></li>
        <li><a class="tool-card" href="/guides/cm-360-explained/"><span class="tc-title">Guide: cm/360 explained</span><p class="tc-desc">Why physical turn distance is the only metric that survives game swaps.</p></a></li>
      </ul>
    </section>
  </div>

  <script>
    import { games } from '../../data/games';

    const byId = Object.fromEntries(games.map((g) => [g.id, g]));
    const $ = (id: string) => document.getElementById(id)!;

    const srcGame = $('src-game') as HTMLSelectElement;
    const dstGame = $('dst-game') as HTMLSelectElement;
    const srcSens = $('src-sens') as HTMLInputElement;
    const srcDpi = $('src-dpi') as HTMLInputElement;
    const dstDpi = $('dst-dpi') as HTMLInputElement;
    const resultEmpty = $('result-empty');
    const resultBody = $('result-body');
    const resultCaption = $('result-caption');
    const resultValue = $('result-value');
    const outCm360 = $('out-cm360');
    const outEdpiSrc = $('out-edpi-src');
    const outEdpiDst = $('out-edpi-dst');
    const outInches = $('out-inches');
    const copyBtn = $('copy-btn');
    const swapBtn = $('swap-btn');

    const fmt = (n: number, d: number) => (Number.isFinite(n) ? n.toFixed(d) : '-');

    function compute() {
      const gs = byId[srcGame.value];
      const gt = byId[dstGame.value];
      const sens = parseFloat(srcSens.value);
      const dpiS = parseFloat(srcDpi.value);
      const dpiT = parseFloat(dstDpi.value);

      $('src-sens-helper').textContent = `Typical range: ${gs.typicalSens}`;
      $('src-yaw-note').textContent = `${gs.name} sensitivity (e.g. 2.0)`;
      $('dst-yaw-note').textContent = `${gt.name} sensitivity`;

      const sensValid = Number.isFinite(sens) && sens > 0;
      const dpiSValid = Number.isFinite(dpiS) && dpiS >= 50 && dpiS <= 12000;
      const dpiTValid = Number.isFinite(dpiT) && dpiT >= 50 && dpiT <= 12000;

      document.querySelectorAll('.field').forEach((f) => f.classList.remove('invalid'));
      if (!sensValid) srcSens.closest('.field')!.classList.add('invalid');
      if (!dpiSValid) srcDpi.closest('.field')!.classList.add('invalid');
      if (!dpiTValid) dstDpi.closest('.field')!.classList.add('invalid');

      if (!sensValid || !dpiSValid || !dpiTValid) {
        resultEmpty.hidden = false;
        resultBody.hidden = true;
        return;
      }

      const converted = (sens * dpiS * gs.yaw) / (dpiT * gt.yaw);
      const cm = (360 / (sens * dpiS * gs.yaw)) * 2.54;
      const cmTarget = (360 / (converted * dpiT * gt.yaw)) * 2.54;

      resultEmpty.hidden = true;
      resultBody.hidden = false;
      resultCaption.textContent = `Your ${gt.name} sensitivity`;
      resultValue.textContent = fmt(converted, gt.sensDecimals);
      outCm360.textContent = `${fmt(cm, 1)} cm`;
      outEdpiSrc.textContent = fmt(sens * dpiS, 0);
      outEdpiDst.textContent = fmt(converted * dpiT, 0);
      outInches.textContent = `${fmt(cm / 2.54, 1)} in`;
      (window as any).__converted = fmt(converted, gt.sensDecimals);
      (window as any).__dstName = gt.name;
    }

    srcGame.addEventListener('change', () => {
      const g = byId[srcGame.value];
      srcSens.value = String(g.defaultSens);
      compute();
    });
    dstGame.addEventListener('change', compute);
    [srcSens, srcDpi, dstDpi].forEach((el) => el.addEventListener('input', compute));

    document.querySelectorAll('.chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        srcDpi.value = (chip as HTMLElement).dataset.dpi!;
        compute();
      });
    });

    swapBtn.addEventListener('click', () => {
      const a = srcGame.value;
      srcGame.value = dstGame.value;
      dstGame.value = a;
      const s = srcSens.value;
      const d = srcDpi.value;
      // carry converted value back as new source where reasonable
      if ((window as any).__converted && (window as any).__converted !== '-') {
        srcSens.value = (window as any).__converted;
      } else {
        srcSens.value = s;
      }
      srcDpi.value = dstDpi.value;
      dstDpi.value = d;
      compute();
    });

    copyBtn.addEventListener('click', async () => {
      const v = (window as any).__converted;
      if (!v) return;
      await copyText(v);
      copyBtn.classList.add('copied');
      setTimeout(() => copyBtn.classList.remove('copied'), 1800);
    });

    // ---- share link (state in URL params; tool result states stay out of the index) ----
    function buildShareUrl(): string {
      const params = new URLSearchParams();
      params.set('sg', srcGame.value);
      params.set('ss', srcSens.value);
      params.set('sd', srcDpi.value);
      params.set('dg', dstGame.value);
      params.set('dd', dstDpi.value);
      return `${location.origin}${location.pathname}?${params.toString()}`;
    }

    function readShareParams() {
      const p = new URLSearchParams(location.search);
      if (!p.has('sg') && !p.has('dg')) return false;
      const setIf = (key: string, el: HTMLSelectElement | HTMLInputElement) => {
        const v = p.get(key);
        if (v) el.value = v;
      };
      if (p.get('sg') && byId[p.get('sg')!]) {
        srcGame.value = p.get('sg')!;
        const g = byId[srcGame.value];
        if (!p.get('ss')) srcSens.value = String(g.defaultSens);
      }
      if (p.get('dg') && byId[p.get('dg')!]) dstGame.value = p.get('dg')!;
      setIf('ss', srcSens);
      setIf('sd', srcDpi);
      setIf('dd', dstDpi);
      return true;
    }

    const shareBtn = $('share-btn');
    shareBtn.addEventListener('click', async () => {
      await copyText(buildShareUrl());
      shareBtn.classList.add('copied');
      setTimeout(() => shareBtn.classList.remove('copied'), 1800);
    });

    async function copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
    }

    // ---- remember last inputs (localStorage) + convert-then-share history ----
    const LS_KEY = 'sensforge:converter';
    const HIST_KEY = 'sensforge:converter:history';

    function saveState() {
      try {
        localStorage.setItem(
          LS_KEY,
          JSON.stringify({
            sg: srcGame.value, ss: srcSens.value, sd: srcDpi.value,
            dg: dstGame.value, dd: dstDpi.value,
          }),
        );
      } catch { /* private mode */ }
    }

    function restoreState(): boolean {
      try {
        const raw = localStorage.getItem(LS_KEY);
        if (!raw) return false;
        const s = JSON.parse(raw);
        if (s.sg && byId[s.sg]) srcGame.value = s.sg;
        if (s.ss) srcSens.value = s.ss;
        if (s.sd) srcDpi.value = s.sd;
        if (s.dg && byId[s.dg]) dstGame.value = s.dg;
        if (s.dd) dstDpi.value = s.dd;
        return true;
      } catch { return false; }
    }

    function renderHistoryLine() {
      try {
        const raw = localStorage.getItem(HIST_KEY);
        const arr: string[] = raw ? JSON.parse(raw) : [];
        const el = $('history-line');
        if (arr.length >= 2) {
          el.hidden = false;
          el.textContent = `Recent conversions: ${arr.slice(0, 3).join(' · ')}`;
        }
      } catch { /* ignore */ }
    }

    function pushHistory(desc: string) {
      try {
        const raw = localStorage.getItem(HIST_KEY);
        const arr: string[] = raw ? JSON.parse(raw) : [];
        arr.unshift(desc);
        localStorage.setItem(HIST_KEY, JSON.stringify(arr.slice(0, 5)));
      } catch { /* ignore */ }
    }

    let lastPushed = '';
    const origCompute = compute;
    compute = function () {
      origCompute();
      saveState();
      const cv = (window as any).__converted;
      const desc = cv && cv !== '-' ? `${byId[srcGame.value].short} ${srcSens.value} → ${byId[dstGame.value].short} ${cv}` : '';
      if (desc && desc !== lastPushed) {
        setTimeout(() => {
          if (desc !== lastPushed) {
            lastPushed = desc;
            pushHistory(desc);
            renderHistoryLine();
          }
        }, 1500);
      }
    };

    if (!readShareParams()) restoreState();
    renderHistoryLine();
    compute();
  </script>
</Base>
