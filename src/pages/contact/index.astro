---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';

const title = 'Contact SensForge — Corrections, Feedback & Questions';
const description =
  'Contact SensForge: report a wrong game constant, suggest a tool, or ask a question. We reply to corrections with a source within a few days.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact' },
];
---

<Base title={title} description={description} breadcrumbs={breadcrumbs} canonical="/contact/">
  <div class="wrap-narrow">
    <Breadcrumbs items={breadcrumbs} />

    <h1>Contact</h1>
    <p class="lead">
      Corrections, tool requests, questions — we read everything. Corrections with a source get priority
      and a changelog credit.
    </p>

    <section class="section">
      <h2 id="email">Email</h2>
      <p>
        <strong>{site.email}</strong> — we typically reply within 3 business days.
      </p>
      <p class="small muted">No phone support. For legal matters, reference "SensForge" in the subject line.</p>
    </section>

    <section class="section">
      <h2 id="report">Reporting a wrong number</h2>
      <p>To make a correction fast, include:</p>
      <ul>
        <li>the tool and the exact value you believe is wrong;</li>
        <li>the value you believe is correct;</li>
        <li>a source (game file, dev post, measurement method, or screenshot with steps).</li>
      </ul>
      <p>
        We verify every report against our <a href="/methodology/">methodology</a> before changing ship
        values, then log it in the <a href="/changelog/">changelog</a>.
      </p>
    </section>

    <section class="section">
      <h2 id="feature">Tool requests</h2>
      <p>
        Want a calculator for a game we do not support yet, or a new tool entirely? Tell us the game and
        what you need to work out — requests that come with the game's config variable names or reference
        values move to the front of the queue.
      </p>
    </section>

    <section class="section">
      <h2 id="privacy-note">Privacy</h2>
      <p class="small muted">
        Emails we receive are kept only to handle your request. See the <a href="/privacy/">privacy policy</a>
        for details.
      </p>
    </section>
  </div>
</Base>
