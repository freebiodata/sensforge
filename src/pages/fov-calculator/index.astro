---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import TrustBlock from '../../components/TrustBlock.astro';
import { site } from '../../data/site';

const title = 'FOV Calculator: Convert Between Aspect Ratios | SensForge';
const description =
  'Convert FOV between 16:9, 4:3, 21:9 and more: horizontal & vertical FOV, degrees per pixel and screen-space match factors. Free.';

const jsonLd = [
  {
    '@type': 'WebApplication',
    '@id': `${site.url}/fov-calculator/#app`,
    name: 'FOV Calculator',
    url: `${site.url}/fov-calculator/`,
    description:
      'Convert vertical and horizontal FOV between aspect ratios, with degrees-per-pixel and monitor-distance match factors.',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Aiming & display', href: '/tools/' },
  { name: 'FOV calculator' },
];

const faq = [
  {
    q: 'What is FOV in games?',
    a: 'FOV (field of view) is the angle of the virtual camera, how much of the world you see on screen. A higher FOV shows more of the scene but makes targets look smaller; a lower FOV zooms in for precision but narrows your peripheral vision.',
  },
  {
    q: 'Why does FOV change when I change resolution or aspect ratio?',
    a: 'Most games keep the vertical FOV fixed, so widening the aspect ratio (16:9 → 21:9) widens the horizontal FOV automatically. If a game fixes horizontal FOV instead, ultrawide users get a cropped vertical view. This calculator shows both so you know which definition a game is using.',
  },
  {
    q: 'What FOV do pro FPS players use?',
    a: 'It varies by game and is often set by tournaments. Common conventions: Overwatch 2 103, Apex Legends 104–110, Counter-Strike 2 90–95 (4:3 stretched users often keep 90), Valorant has a fixed 103 horizontal. Always check your league rules.',
  },
  {
    q: 'Does FOV affect sensitivity?',
    a: 'Turning distance (cm/360) is unaffected by FOV. Perception of speed is not, a high FOV makes the world move past faster at the same sensitivity. When pros say "FOV changes your aim," they mean perception and target size, not the rotation maths.',
  },
  {
    q: 'What is the screen-space match factor?',
    a: 'It is <code>tan(hFOV_target ÷ 2) ÷ tan(hFOV_source ÷ 2)</code>, the multiplier you apply to your sensitivity when changing aspect ratio to keep the same on-screen mouse feel at the crosshair. For 16:9 → 4:3 it is 0.750, which is why 4:3 stretched players use <code>m_yaw 0.0165</code> (= 0.022 × 0.75). See the worked example in the "How FOV conversion works" section.',
  },
];

const aspects = [
  { id: '16:9', label: '16:9 (standard widescreen)', ratio: 16 / 9 },
  { id: '16:10', label: '16:10', ratio: 16 / 10 },
  { id: '4:3', label: '4:3 (classic / stretched)', ratio: 4 / 3 },
  { id: '5:4', label: '5:4', ratio: 5 / 4 },
  { id: '21:9', label: '21:9 (ultrawide)', ratio: 21 / 9 },
  { id: '32:9', label: '32:9 (super ultrawide)', ratio: 32 / 9 },
];
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={breadcrumbs}
  canonical="/fov-calculator/"
>
  <div class="wrap">
    <Breadcrumbs items={breadcrumbs} />

    <div class="hero">
      <h1>FOV Calculator &amp; Converter</h1>
      <p class="value-line">
        Convert your field of view between 16:9, 4:3, 21:9 and more, see horizontal &amp; vertical FOV,
        degrees per pixel, and the exact mouse-match factor when you change aspect ratios.
      </p>
      <ul class="trust-microline">
        <li class="badge badge-green">Runs in your browser</li>
        <li class="badge">Free · No sign-up</li>
        <li class="badge">6 aspect ratios</li>
      </ul>
    </div>

    <section class="tool" aria-labelledby="tool-heading">
      <h2 id="tool-heading" class="visually-hidden">FOV calculator tool</h2>

      <div class="tool-grid cols-2">
        <div>
          <div class="field">
            <label for="fov-input">FOV value</label>
            <input type="number" id="fov-input" inputmode="decimal" min="1" max="179" step="1" value="103" />
            <span class="helper">Use the number your game shows (usually vertical or a fixed "FOV" value like 103).</span>
            <span class="error" role="alert">Enter a FOV between 1 and 179.</span>
          </div>
          <div class="field">
            <label for="input-type">This value is</label>
            <select id="input-type">
              <option value="vertical" selected>Vertical FOV (most games)</option>
              <option value="horizontal">Horizontal FOV (some games / calculators)</option>
            </select>
          </div>
          <div class="field">
            <label for="src-aspect">Source aspect ratio</label>
            <select id="src-aspect">
              {aspects.map((a) => (
                <option value={a.id} selected={a.id === '16:9'}>{a.label}</option>
              ))}
            </select>
          </div>
        </div>

        <div>
          <div class="field">
            <label for="dst-aspect">Target aspect ratio</label>
            <select id="dst-aspect">
              {aspects.map((a) => (
                <option value={a.id} selected={a.id === '4:3'}>{a.label}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="pixels">Horizontal resolution (px)</label>
            <input type="number" id="pixels" inputmode="numeric" min="640" max="7680" step="8" value="1920" />
            <span class="helper">Used for degrees per pixel.</span>
          </div>
          <div class="field">
            <label>Screen-space match factor</label>
            <div class="result-value" id="match-factor" style="font-size:1.5rem">-</div>
            <span class="helper">Multiply your sensitivity (or m_yaw) by this when switching from the source to the target aspect, to keep the same center-screen mouse feel. Example: 16:9 → 4:3 gives 0.750, the classic m_yaw 0.022 → 0.0165 adjustment.</span>
          </div>
          <div class="field">
            <label>Horizontal image stretch</label>
            <div class="result-value" id="stretch-out" style="font-size:1.5rem">-</div>
            <span class="helper" id="factor-note">The stretch factor resolution guides quote.</span>
          </div>
        </div>
      </div>

      <div class="result-panel" aria-live="polite">
        <div id="result-body">
          <div class="small muted">Converted FOV</div>
          <div class="result-value" id="result-value">-</div>
          <div class="result-meta">
            <div class="kv"><div class="k">Horizontal FOV (source)</div><div class="v" id="out-h-src">-</div></div>
            <div class="kv"><div class="k">Vertical FOV (source)</div><div class="v" id="out-v-src">-</div></div>
            <div class="kv"><div class="k">Horizontal FOV (target)</div><div class="v" id="out-h-dst">-</div></div>
            <div class="kv"><div class="k">Degrees per pixel</div><div class="v" id="out-dpp">-</div></div>
          </div>
          <div class="result-actions">
            <a class="btn btn-secondary" href="/sens-randomizer/">Try the sens randomizer →</a>
            <a class="btn btn-secondary" href="/sensitivity-converter/">Convert sensitivity →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="how">
      <h2 id="how">How FOV conversion works</h2>
      <p>
        FOV is an angle; aspect ratio changes what it means. If a game fixes <strong>vertical</strong> FOV,
        the horizontal FOV for aspect ratio <code>r</code> is:
      </p>
      <p><code>hFOV = 2 × atan( tan(vFOV ÷ 2) × r )</code></p>
      <p>
        The <strong>screen-space match factor</strong> between two setups (keeping the same on-screen
        mouse feel near the crosshair) is the ratio of the tangents of their half horizontal FOVs:
      </p>
      <p><code>factor(source → target) = tan(hFOV_target ÷ 2) ÷ tan(hFOV_source ÷ 2)</code></p>
      <p>
        Example: 16:9 → 4:3 gives <code>0.750</code>. CS players apply exactly this by setting
        <code>m_yaw 0.0165</code> (= 0.022 × 0.75) when they play 4:3 stretched, keeping horizontal and
        vertical screen speed identical. Read the other way, the horizontal image appears
        <code>1.333×</code> wider, the "stretch factor" you see quoted in resolution guides.
      </p>
    </section>

    <section class="section" aria-labelledby="reference">
      <h2 id="reference">Vertical → horizontal FOV reference</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th class="num">Vertical FOV</th><th class="num">Horizontal @ 16:9</th><th class="num">Horizontal @ 4:3</th><th class="num">Horizontal @ 21:9</th></tr></thead>
          <tbody>
            <tr><td class="num">60</td><td class="num">91.5°</td><td class="num">75.2°</td><td class="num">106.8°</td></tr>
            <tr><td class="num">70</td><td class="num">102.4°</td><td class="num">86.1°</td><td class="num">117.1°</td></tr>
            <tr><td class="num">80</td><td class="num">112.3°</td><td class="num">96.4°</td><td class="num">125.9°</td></tr>
            <tr><td class="num">90</td><td class="num">121.3°</td><td class="num">106.3°</td><td class="num">133.6°</td></tr>
            <tr><td class="num">103</td><td class="num">131.8°</td><td class="num">118.4°</td><td class="num">142.4°</td></tr>
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:10px">Calculated with the formula above; verify game-specific behaviour in the calculator.</p>
    </section>

    <Faq items={faq} />

    <TrustBlock>
      <p class="mb-0">
        <strong>Everything is calculated locally.</strong> No inputs are transmitted. Formula details:
        <a href="/methodology/">methodology page</a>.
      </p>
    </TrustBlock>
  </div>

  <script>
    const RATIOS: Record<string, number> = {
      '16:9': 16 / 9,
      '16:10': 16 / 10,
      '4:3': 4 / 3,
      '5:4': 5 / 4,
      '21:9': 21 / 9,
      '32:9': 32 / 9,
    };
    const $ = (id: string) => document.getElementById(id)!;
    const rad = (d: number) => (d * Math.PI) / 180;
    const deg = (r: number) => (r * 180) / Math.PI;

    function compute() {
      const fov = parseFloat(($('fov-input') as HTMLInputElement).value);
      const type = ($('input-type') as HTMLSelectElement).value;
      const srcR = RATIOS[($('src-aspect') as HTMLSelectElement).value];
      const dstR = RATIOS[($('dst-aspect') as HTMLSelectElement).value];
      const px = parseFloat(($('pixels') as HTMLInputElement).value);

      const valid = Number.isFinite(fov) && fov > 1 && fov < 179;
      document.querySelectorAll('.field').forEach((f) => f.classList.remove('invalid'));
      if (!valid) {
        ($('fov-input') as HTMLInputElement).closest('.field')!.classList.add('invalid');
        return;
      }

      // normalize to vertical
      let vFov: number;
      if (type === 'vertical') vFov = fov;
      else vFov = deg(2 * Math.atan(Math.tan(rad(fov) / 2) / srcR));

      const hSrc = deg(2 * Math.atan(Math.tan(rad(vFov) / 2) * srcR));
      const hDst = deg(2 * Math.atan(Math.tan(rad(vFov) / 2) * dstR));
      const vDst = vFov;

      const factor = Math.tan(rad(hDst) / 2) / Math.tan(rad(hSrc) / 2);
      const stretch = 1 / factor;
      const dpp = hSrc / px;

      $('result-value').textContent = `vFOV ${vDst.toFixed(1)}° · hFOV ${hDst.toFixed(1)}° (target ${($('dst-aspect') as HTMLSelectElement).value})`;
      $('out-h-src').textContent = `${hSrc.toFixed(1)}°`;
      $('out-v-src').textContent = `${vFov.toFixed(1)}°`;
      $('out-h-dst').textContent = `${hDst.toFixed(1)}°`;
      $('out-dpp').textContent = `${dpp.toFixed(4)}° / px`;
      $('match-factor').textContent = factor.toFixed(4);
      $('stretch-out').textContent = `${stretch.toFixed(3)}×`;
      $('factor-note').textContent = `Switch ${($('src-aspect') as HTMLSelectElement).value} → ${($('dst-aspect') as HTMLSelectElement).value}: multiply sensitivity by ${factor.toFixed(3)} for the same center-screen mouse feel; the horizontal image appears ${stretch.toFixed(2)}× wider.`;
    }

    ['fov-input', 'input-type', 'src-aspect', 'dst-aspect', 'pixels'].forEach((id) =>
      $(id).addEventListener('input', compute),
    );
    compute();
  </script>
</Base>
