---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';
import { site } from '../../data/site';

const title = 'All Tools: FPS Aiming & Display Calculators | SensForge';
const description =
  'Every SensForge tool in one place: sensitivity converter, eDPI, cm/360, DPI analyzer, FOV, crosshair generator and randomizer. Free, in-browser.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'All tools' },
];

const convertors = [
  { href: '/sensitivity-converter/', title: 'Sensitivity Converter', desc: 'Convert mouse sensitivity between 13 FPS games with cm/360 matching.' },
  { href: '/edpi-calculator/', title: 'eDPI Calculator', desc: 'Effective DPI from sensitivity × DPI, with competitive band reference.' },
  { href: '/cm-360-calculator/', title: 'cm/360 Calculator', desc: 'Physical mouse distance per full turn, with mousepad coverage checks.' },
  { href: '/dpi-analyzer/', title: 'Mouse DPI Analyzer', desc: 'Measure your real DPI from sensor counts, no driver needed.' },
];

const aiming = [
  { href: '/fov-calculator/', title: 'FOV Calculator', desc: 'Convert FOV across 6 aspect ratios with monitor-match factors.' },
  { href: '/crosshair-generator/', title: 'Crosshair Generator', desc: 'Live crosshair designer with PNG export and game-setting mapping.' },
  { href: '/sens-randomizer/', title: 'Sensitivity Randomizer', desc: 'Practice rolls within a chosen band to sharpen mouse control.' },
];

const chooser = [
  ['I keep missing close-range flicks after switching games', 'Sensitivity Converter'],
  ['I do not know my real DPI', 'Mouse DPI Analyzer'],
  ['Targets feel too small / too big after a monitor change', 'FOV Calculator'],
  ['My aim plateaus on the same settings', 'Sensitivity Randomizer'],
  ['I want to compare my settings with friends', 'eDPI Calculator'],
  ['My mouse runs out of pad on big turns', 'cm/360 Calculator'],
  ['My crosshair disappears on bright walls', 'Crosshair Generator'],
];
---

<Base
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  canonical="/tools/"
>
  <div class="wrap">
    <Breadcrumbs items={breadcrumbs} />

    <div class="hero">
      <h1>All tools</h1>
      <p class="value-line">
        Seven focused calculators for competitive FPS aiming, all free, all running entirely in your browser.
      </p>
    </div>

    <section class="section" aria-labelledby="converters">
      <h2 id="converters" style="margin-top:0">Converters &amp; measurement</h2>
      <ul class="tool-cards">
        {convertors.map((t) => <ToolCard href={t.href} title={t.title} desc={t.desc} />)}
      </ul>
    </section>

    <section class="section" aria-labelledby="aiming">
      <h2 id="aiming">Aiming &amp; display</h2>
      <ul class="tool-cards">
        {aiming.map((t) => <ToolCard href={t.href} title={t.title} desc={t.desc} />)}
      </ul>
    </section>

    <section class="section" aria-labelledby="chooser">
      <h2 id="chooser">Which tool do I need?</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Your problem</th><th>Start here</th></tr></thead>
          <tbody>
            {chooser.map(([problem, tool]) => (
              <tr><td>{problem}</td><td>{tool}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-cat">
      <h2 id="faq-cat">Quick answers</h2>
      <div class="faq">
        <details>
          <summary>Are all the tools really free?</summary>
          <div class="faq-body"><p>Yes, every calculator is free with no sign-up, no watermark and no usage caps. The math runs client-side, so there is nothing to meter.</p></div>
        </details>
        <details>
          <summary>Do the tools store my settings?</summary>
          <div class="faq-body"><p>No. Values you enter are processed in your browser and never transmitted or saved after you close the tab.</p></div>
        </details>
        <details>
          <summary>Which games are supported?</summary>
          <div class="faq-body"><p>Valorant, Counter-Strike 2, Apex Legends, Overwatch 2, Fortnite, Rainbow Six Siege, Call of Duty, Marvel Rivals, The Finals, Destiny 2, Halo Infinite, Deadlock and Tarkov, 13 in total, each with a source-labelled yaw value.</p></div>
        </details>
      </div>
    </section>
  </div>
</Base>
